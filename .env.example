# ─────────────────────────────────────────────────────────────────────────────
# Supabase — entirely optional.
#
# With these unset the site runs off the bundled research corpus in
# src/lib/data/seed/. Set them to serve content from Postgres instead, so the
# corpus can be edited without a redeploy.
#
# Copy to .env.local for local dev, and add the two NEXT_PUBLIC_ vars to your
# Vercel project (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
# Safe to expose: RLS grants this key SELECT only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role
# SECRET. Bypasses RLS. Used only by `npm run db:seed`.
# Never add this to Vercel or commit it.
SUPABASE_SERVICE_ROLE_KEY=
